{
  "manifest_version": 3,
  "name": "BD Downloader",
  "version": "2.7.5",
  "description": "BD Downloader - catches your downloads and sends them to the BD Downloader app.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon16.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
